{
  "name": "iconiq-education",
  "private": true,
  "version": "1.0.0",
  "description": "ICONIQ free US and Canadian market information and education",
  "workspaces": [
    "server",
    "portal",
    "admin"
  ],
  "scripts": {
    "setup": "npm install",
    "seed": "npm run seed -w server",
    "dev:server": "npm run dev -w server",
    "dev:portal": "npm run dev -w portal",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w portal && npm run build -w admin",
    "start": "npm run start -w server",
    "test:ui": "node tests/ui-audit.mjs",
    "test:api": "node server/src/smoke.mjs",
    "test:admin": "node tests/admin-migration.mjs && node tests/admin-workflows.mjs",
    "test:wealth": "node --test tests/wealth-projection.test.mjs",
    "test:wealth-ui": "node tests/wealth-mobile.mjs",
    "test:auth": "node tests/auth-ui.mjs",
    "test:theme-sync": "node tests/theme-sync.mjs",
    "test:debug": "node tests/debug-suite.mjs",
    "sync:canada": "node server/src/sync-canada.mjs",
    "test:canada": "node tests/canadian-universe.mjs",
    "test:kyc-bank": "node tests/kyc-bank.mjs",
    "test:tax-prices": "node tests/tax-prices.mjs",
    "test:production": "node tests/production-safety.mjs",
    "test:chart-auto": "node tests/chart-auto.mjs",
    "test:chart-fullscreen": "node tests/chart-fullscreen.mjs",
    "test:chart-pan": "node tests/chart-pan.mjs",
    "test:live-chart": "node tests/live-chart.mjs",
    "test:chart-options": "node tests/chart-timeframes.mjs && node tests/chart-options.mjs",
    "test:mobile-sheet-scroll": "node tests/mobile-sheet-scroll.mjs",
    "test:tradingview-symbols": "node tests/tradingview-symbols.mjs",
    "test:logos": "node tests/stock-logos.mjs && node tests/stock-logo-cache.mjs",
    "cache:logos": "node server/src/warm-logo-cache.js",
    "test:logo-cache-ui": "node tests/stock-logo-cache-browser.mjs",
    "test:market-pagination": "node tests/market-pagination.mjs",
    "test:market-navigation": "node tests/market-navigation.mjs",
    "test:market-tools": "node tests/collapsible-market-tools.mjs",
    "test:side-order-entry": "node tests/side-order-entry.mjs",
    "test:ui-polish": "node tests/ui-polish.mjs",
    "test:account-sections": "node tests/account-sections.mjs",
    "test:quote-stability": "node tests/quote-stability.mjs",
    "test:us-display-quotes": "node tests/us-display-quotes.mjs",
    "test:tradingview-fullscreen": "node tests/tradingview-fullscreen-sizing.mjs",
    "test:market-time": "node tests/market-time.mjs",
    "test:login-autofill": "node tests/login-cursor-autofill.mjs",
    "test:browser-push": "node tests/browser-push-api.mjs && node tests/browser-push-worker.mjs && node tests/browser-push-ui.mjs",
    "test:mobile-chart-review": "node tests/mobile-chart-review.mjs",
    "test:chart-trade-funding": "node tests/chart-trade-funding.mjs",
    "test:mobile-chart-space": "node tests/mobile-chart-space.mjs",
    "test:paper": "node --test tests/paper-trading.test.mjs tests/paper-migration.test.mjs",
    "test:paper-ui": "node tests/paper-ui.mjs",
    "test:release": "node --test tests/release-api.test.mjs tests/release-config.test.mjs",
    "test:release-ui": "node tests/education-ui.mjs",
    "build:native": "npm run build:native -w portal",
    "native:sync": "npm run native:sync -w portal",
    "native:assets": "npm run native:assets -w portal",
    "test:mobile-hosted": "node tests/mobile-hosted-shell.mjs",
    "test:mobile-polish": "node tests/mobile-polish-ui.mjs",
    "test:widgets": "node --test tests/tradingview-widgets.test.mjs && node tests/tradingview-widgets-ui.mjs",
    "test:offline-study": "node tests/offline-study.mjs",
    "test:native-push": "node --test tests/native-push.test.mjs",
    "release:check": "node scripts/apple-release-check.mjs",
    "store:artwork": "node scripts/store-artwork.mjs"
  },
  "overrides": {
    "tar": "^7.5.22",
    "postcss-selector-parser": "^7.1.7",
    "uuid": "^11.1.1"
  }
}
